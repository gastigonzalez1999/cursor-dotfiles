# This repo is cloned on both Windows and macOS. Without this, Windows checkouts
# commit CRLF into the installers and the next mac clone fails with
# "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

*.sh    text eol=lf
*.ps1   text eol=crlf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mdc   text eol=lf
